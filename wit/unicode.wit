package oc:machine@0.1.0;

/// Text measurement consistent with how screens render text.
interface unicode {
    /// Number of screen cells the character occupies (0, 1 or 2).
    char-width: func(c: char) -> u8;

    /// Number of screen cells the string occupies.
    string-width: func(s: string) -> u32;

    /// Truncates the string so that it occupies fewer than `width` cells.
    truncate-to-width: func(s: string, width: u32) -> string;
}

